{
  "name": "rpa-loop-extension",
  "displayName": "AutoLoop RPA - Iterador Web",
  "version": "1.0.1",
  "description": "Selecciona componentes de la página y ejecuta acciones iterativas a partir de una lista de registros (CSV/JSON).",
  "author": "Cesar Cardenas",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package"
  },
  "dependencies": {
    "@medv/finder": "^3.2.0",
    "@plasmohq/messaging": "^0.7.0",
    "@plasmohq/storage": "^1.13.0",
    "lucide-react": "^0.454.0",
    "papaparse": "^5.4.1",
    "plasmo": "^0.89.2",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.277",
    "@types/node": "^20.14.10",
    "@types/papaparse": "^5.3.14",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.5.3"
  },
  "manifest": {
    "host_permissions": [
      "https://*/*",
      "http://*/*"
    ],
    "permissions": [
      "storage",
      "sidePanel",
      "activeTab",
      "tabs",
      "scripting"
    ]
  }
}
